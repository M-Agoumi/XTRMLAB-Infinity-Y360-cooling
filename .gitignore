# --- Build output -----------------------------------------------------
build/
dist/
*.manifest

# --- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- Machine-specific, generated on first run -------------------------
# config.json is yours: sensor names differ per motherboard. The repo ships
# config.example.json instead.
config.json
sensors.txt

# --- Run output -------------------------------------------------------
# Regenerated on every run; calibration_results.txt is kept deliberately,
# since the measured table is the evidence behind the temperature encoding
# and it is quoted in FINDINGS.md.
test_output.log
*.log

# --- Local scratch ----------------------------------------------------
panel.lock
pcmonitor_autostart_backup/
daemon.pid
*.bak
*.tmp
*.orig

# --- Downloaded third-party binaries ----------------------------------
# INSTALL.bat fetches LibreHardwareMonitorLib.dll here from its own project.
# It is MPL-2.0 and is not ours to redistribute.
lib/

# --- Vendor material (do NOT commit) ----------------------------------
# The PC Monitor binaries are proprietary. FINDINGS.md documents the
# protocol; the vendor's code has no business in this repo.
PC_Monitor.exe
*.dll
*.sys

# --- Editors / OS -----------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
Desktop.ini
